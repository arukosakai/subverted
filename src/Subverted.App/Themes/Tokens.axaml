<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- What stays put when the preset changes: status tones and diff washes, one set per light and
       dark, so every preset of a variant reads a change the same way. Surfaces are the preset's. -->
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="Tone.Modified" Color="#FFB547" />
      <SolidColorBrush x:Key="Tone.Added" Color="#34D399" />
      <SolidColorBrush x:Key="Tone.Deleted" Color="#F87171" />
      <SolidColorBrush x:Key="Tone.Replaced" Color="#A78BFA" />
      <SolidColorBrush x:Key="Tone.Renamed" Color="#60A5FA" />
      <SolidColorBrush x:Key="Tone.Conflict" Color="#FB5C8C" />
      <SolidColorBrush x:Key="Tone.Missing" Color="#FB923C" />
      <SolidColorBrush x:Key="Tone.Unversioned" Color="#94A3B8" />
      <SolidColorBrush x:Key="Tone.Quiet" Color="#6E737D" />
      <SolidColorBrush x:Key="Tone.Modified.Soft" Color="#26FFB547" />
      <SolidColorBrush x:Key="Tone.Added.Soft" Color="#2634D399" />
      <SolidColorBrush x:Key="Tone.Deleted.Soft" Color="#26F87171" />
      <SolidColorBrush x:Key="Tone.Replaced.Soft" Color="#26A78BFA" />
      <SolidColorBrush x:Key="Tone.Renamed.Soft" Color="#2660A5FA" />
      <SolidColorBrush x:Key="Tone.Conflict.Soft" Color="#2EFB5C8C" />
      <SolidColorBrush x:Key="Tone.Missing.Soft" Color="#26FB923C" />
      <SolidColorBrush x:Key="Tone.Unversioned.Soft" Color="#1F94A3B8" />
      <SolidColorBrush x:Key="Tone.Quiet.Soft" Color="#1A6E737D" />

      <!-- Diff lines: a wash across the line, a little stronger under the numbers. -->
      <SolidColorBrush x:Key="Diff.Added.Line" Color="#1C34D399" />
      <SolidColorBrush x:Key="Diff.Added.Gutter" Color="#2E34D399" />
      <SolidColorBrush x:Key="Diff.Removed.Line" Color="#1CF87171" />
      <SolidColorBrush x:Key="Diff.Removed.Gutter" Color="#2EF87171" />
      <SolidColorBrush x:Key="Diff.Hunk" Color="#0CFFFFFF" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="Tone.Modified" Color="#B7791F" />
      <SolidColorBrush x:Key="Tone.Added" Color="#0F9F6E" />
      <SolidColorBrush x:Key="Tone.Deleted" Color="#DC2626" />
      <SolidColorBrush x:Key="Tone.Replaced" Color="#7C3AED" />
      <SolidColorBrush x:Key="Tone.Renamed" Color="#2563EB" />
      <SolidColorBrush x:Key="Tone.Conflict" Color="#DB2777" />
      <SolidColorBrush x:Key="Tone.Missing" Color="#EA580C" />
      <SolidColorBrush x:Key="Tone.Unversioned" Color="#64748B" />
      <SolidColorBrush x:Key="Tone.Quiet" Color="#9CA3AF" />
      <SolidColorBrush x:Key="Tone.Modified.Soft" Color="#1FB7791F" />
      <SolidColorBrush x:Key="Tone.Added.Soft" Color="#1F0F9F6E" />
      <SolidColorBrush x:Key="Tone.Deleted.Soft" Color="#1FDC2626" />
      <SolidColorBrush x:Key="Tone.Replaced.Soft" Color="#1F7C3AED" />
      <SolidColorBrush x:Key="Tone.Renamed.Soft" Color="#1F2563EB" />
      <SolidColorBrush x:Key="Tone.Conflict.Soft" Color="#24DB2777" />
      <SolidColorBrush x:Key="Tone.Missing.Soft" Color="#1FEA580C" />
      <SolidColorBrush x:Key="Tone.Unversioned.Soft" Color="#1A64748B" />
      <SolidColorBrush x:Key="Tone.Quiet.Soft" Color="#149CA3AF" />

      <SolidColorBrush x:Key="Diff.Added.Line" Color="#1A0F9F6E" />
      <SolidColorBrush x:Key="Diff.Added.Gutter" Color="#2B0F9F6E" />
      <SolidColorBrush x:Key="Diff.Removed.Line" Color="#1ADC2626" />
      <SolidColorBrush x:Key="Diff.Removed.Gutter" Color="#2BDC2626" />
      <SolidColorBrush x:Key="Diff.Hunk" Color="#0A000000" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>

  <!-- oto's radii: small enough that a dense table still reads as rows, not as cards. -->
  <CornerRadius x:Key="RowRadius">6</CornerRadius>
  <CornerRadius x:Key="CardRadius">8</CornerRadius>
  <CornerRadius x:Key="PanelRadius">10</CornerRadius>
  <CornerRadius x:Key="CapsuleRadius">999</CornerRadius>

  <!-- Whichever the platform has: Windows ships Cascadia Mono and Consolas, macOS ships Menlo. -->
  <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas, Menlo, Courier New</FontFamily>

  <!-- Lucide's line icons, which oto draws with: 24x24, stroked, so they take the text colour like a glyph. -->
  <StreamGeometry x:Key="Icon.Folder">M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-0.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z</StreamGeometry>
  <StreamGeometry x:Key="Icon.FolderPlus">M20 20a2 2 0 0 0 2-2V8a2 2 0 0 0-2-2h-7.9a2 2 0 0 1-1.69-0.9L9.6 3.9A2 2 0 0 0 7.93 3H4a2 2 0 0 0-2 2v13a2 2 0 0 0 2 2Z M12 10v6 M9 13h6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Plus">M5 12h14 M12 5v14</StreamGeometry>
  <StreamGeometry x:Key="Icon.Check">M20 6L9 17l-5-5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Alert">M21.73 18l-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3Z M12 9v4 M12 17h0.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.Unplugged">M9 7V3M15 7V3M7 7h10v4a5 5 0 0 1-10 0Z M12 16v5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Server">M4 5h16v5H4Z M4 14h16v5H4Z M8 7.5v0.1M8 16.5v0.1</StreamGeometry>
  <StreamGeometry x:Key="Icon.Lock">M5 11h14a2 2 0 0 1 2 2v7a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-7a2 2 0 0 1 2-2Z M7 11V7a5 5 0 0 1 10 0v4</StreamGeometry>
  <StreamGeometry x:Key="Icon.History">M3 12a9 9 0 1 0 9-9a9.75 9.75 0 0 0-6.74 2.74L3 8 M3 3v5h5 M12 7v5l4 2</StreamGeometry>
  <StreamGeometry x:Key="Icon.Diff">M12 3v14 M5 10h14 M5 21h14</StreamGeometry>
  <StreamGeometry x:Key="Icon.File">M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z M14 2v4a2 2 0 0 0 2 2h4</StreamGeometry>
  <StreamGeometry x:Key="Icon.Open">M15 3h6v6 M10 14L21 3 M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Branch">M6 3v12 M18 6a3 3 0 1 0 0 6a3 3 0 1 0 0-6Z M6 15a3 3 0 1 0 0 6a3 3 0 1 0 0-6Z M18 12a9 9 0 0 1-9 9</StreamGeometry>
  <StreamGeometry x:Key="Icon.Changes">M3 17l2 2l4-4 M3 7l2 2l4-4 M13 6h8 M13 12h8 M13 18h8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Palette">M12 22a1 1 0 0 1 0-20a10 9 0 0 1 10 9a5 5 0 0 1-5 5h-2.25a1.75 1.75 0 0 0-1.4 2.8l0.3 0.4a1.75 1.75 0 0 1-1.4 2.8Z M7.5 10.5h0.01 M10.5 6.5h0.01 M15.5 7.5h0.01</StreamGeometry>
  <StreamGeometry x:Key="Icon.ChevronDown">M6 9l6 6l6-6</StreamGeometry>
  <StreamGeometry x:Key="Icon.Search">M11 3a8 8 0 1 0 0 16a8 8 0 1 0 0-16Z M21 21l-4.3-4.3</StreamGeometry>
  <StreamGeometry x:Key="Icon.Undo">M9 14L4 9l5-5 M4 9h10.5a5.5 5.5 0 0 1 5.5 5.5a5.5 5.5 0 0 1-5.5 5.5H11</StreamGeometry>
  <StreamGeometry x:Key="Icon.Terminal">M4 17l6-6l-6-6 M12 19h8</StreamGeometry>
  <StreamGeometry x:Key="Icon.Refresh">M3 12a9 9 0 0 1 9-9a9.75 9.75 0 0 1 6.74 2.74L21 8 M21 3v5h-5 M21 12a9 9 0 0 1-9 9a9.75 9.75 0 0 1-6.74-2.74L3 16 M8 16H3v5</StreamGeometry>
  <StreamGeometry x:Key="Icon.Commit">M12 9a3 3 0 1 0 0 6a3 3 0 1 0 0-6Z M3 12h6 M15 12h6</StreamGeometry>
</ResourceDictionary>
