<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Solarized Dark: oto's palette of the same name. -->
  <Color x:Key="BgColor">#002B36</Color>
  <Color x:Key="SurfaceColor">#073642</Color>
  <Color x:Key="RaisedColor">#16424C</Color>
  <Color x:Key="RailColor">#00232C</Color>
  <Color x:Key="LineColor">#0E4756</Color>
  <Color x:Key="TextColor">#FDF6E3</Color>
  <Color x:Key="MutedColor">#93A1A1</Color>
  <Color x:Key="FaintColor">#587276</Color>
  <Color x:Key="AccentColor">#268BD2</Color>
  <Color x:Key="AccentHoverColor">#4FA8DD</Color>
  <Color x:Key="AccentPressedColor">#1E73A8</Color>
  <Color x:Key="OnAccentColor">#FDF6E3</Color>
  <Color x:Key="HoverColor">#15FFFFFF</Color>
  <Color x:Key="SelectedColor">#38268BD2</Color>

  <!-- Fluent's own controls follow the accent too. -->
  <Color x:Key="SystemAccentColor">#268BD2</Color>
  <Color x:Key="SystemAccentColorLight1">#4FA8DD</Color>
  <Color x:Key="SystemAccentColorLight2">#4FA8DD</Color>
  <Color x:Key="SystemAccentColorLight3">#4FA8DD</Color>
  <Color x:Key="SystemAccentColorDark1">#1E73A8</Color>
  <Color x:Key="SystemAccentColorDark2">#1E73A8</Color>
  <Color x:Key="SystemAccentColorDark3">#1E73A8</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="RailBrush" Color="{StaticResource RailColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />

  <!-- The names the first views were written against, kept so they keep resolving. -->
  <SolidColorBrush x:Key="WindowFallbackBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource RailColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="GlassEdgeBrush" Color="{StaticResource LineColor}" />
</ResourceDictionary>
