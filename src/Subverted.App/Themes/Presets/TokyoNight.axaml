<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Tokyo Night: oto's palette of the same name. -->
  <Color x:Key="BgColor">#1A1B26</Color>
  <Color x:Key="SurfaceColor">#24283B</Color>
  <Color x:Key="RaisedColor">#2D3246</Color>
  <Color x:Key="RailColor">#15161F</Color>
  <Color x:Key="LineColor">#414868</Color>
  <Color x:Key="TextColor">#C0CAF5</Color>
  <Color x:Key="MutedColor">#7982A9</Color>
  <Color x:Key="FaintColor">#535975</Color>
  <Color x:Key="AccentColor">#7AA2F7</Color>
  <Color x:Key="AccentHoverColor">#89B4FA</Color>
  <Color x:Key="AccentPressedColor">#5E8AE6</Color>
  <Color x:Key="OnAccentColor">#1A1B26</Color>
  <Color x:Key="HoverColor">#15FFFFFF</Color>
  <Color x:Key="SelectedColor">#387AA2F7</Color>

  <!-- Fluent's own controls follow the accent too. -->
  <Color x:Key="SystemAccentColor">#7AA2F7</Color>
  <Color x:Key="SystemAccentColorLight1">#89B4FA</Color>
  <Color x:Key="SystemAccentColorLight2">#89B4FA</Color>
  <Color x:Key="SystemAccentColorLight3">#89B4FA</Color>
  <Color x:Key="SystemAccentColorDark1">#5E8AE6</Color>
  <Color x:Key="SystemAccentColorDark2">#5E8AE6</Color>
  <Color x:Key="SystemAccentColorDark3">#5E8AE6</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="RailBrush" Color="{StaticResource RailColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />

  <!-- The names the first views were written against, kept so they keep resolving. -->
  <SolidColorBrush x:Key="WindowFallbackBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource RailColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="GlassEdgeBrush" Color="{StaticResource LineColor}" />
</ResourceDictionary>
