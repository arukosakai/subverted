<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!-- Claude: oto's palette of the same name. -->
  <Color x:Key="BgColor">#F5F0E8</Color>
  <Color x:Key="SurfaceColor">#FAF6EF</Color>
  <Color x:Key="RaisedColor">#EDE9E2</Color>
  <Color x:Key="RailColor">#ECE8E0</Color>
  <Color x:Key="LineColor">#E1D9CB</Color>
  <Color x:Key="TextColor">#1B1A18</Color>
  <Color x:Key="MutedColor">#6B645A</Color>
  <Color x:Key="FaintColor">#A29C93</Color>
  <Color x:Key="AccentColor">#C96442</Color>
  <Color x:Key="AccentHoverColor">#D87555</Color>
  <Color x:Key="AccentPressedColor">#A24E32</Color>
  <Color x:Key="OnAccentColor">#FAF6EF</Color>
  <Color x:Key="HoverColor">#0A000000</Color>
  <Color x:Key="SelectedColor">#26C96442</Color>

  <!-- Fluent's own controls follow the accent too. -->
  <Color x:Key="SystemAccentColor">#C96442</Color>
  <Color x:Key="SystemAccentColorLight1">#D87555</Color>
  <Color x:Key="SystemAccentColorLight2">#D87555</Color>
  <Color x:Key="SystemAccentColorLight3">#D87555</Color>
  <Color x:Key="SystemAccentColorDark1">#A24E32</Color>
  <Color x:Key="SystemAccentColorDark2">#A24E32</Color>
  <Color x:Key="SystemAccentColorDark3">#A24E32</Color>

  <SolidColorBrush x:Key="BgBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="RaisedBrush" Color="{StaticResource RaisedColor}" />
  <SolidColorBrush x:Key="RailBrush" Color="{StaticResource RailColor}" />
  <SolidColorBrush x:Key="LineBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
  <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
  <SolidColorBrush x:Key="FaintBrush" Color="{StaticResource FaintColor}" />
  <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
  <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentHoverColor}" />
  <SolidColorBrush x:Key="AccentPressedBrush" Color="{StaticResource AccentPressedColor}" />
  <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}" />
  <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
  <SolidColorBrush x:Key="SelectedBrush" Color="{StaticResource SelectedColor}" />

  <!-- The names the first views were written against, kept so they keep resolving. -->
  <SolidColorBrush x:Key="WindowFallbackBrush" Color="{StaticResource BgColor}" />
  <SolidColorBrush x:Key="SidebarBrush" Color="{StaticResource RailColor}" />
  <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource SurfaceColor}" />
  <SolidColorBrush x:Key="DividerBrush" Color="{StaticResource LineColor}" />
  <SolidColorBrush x:Key="GlassEdgeBrush" Color="{StaticResource LineColor}" />
</ResourceDictionary>
