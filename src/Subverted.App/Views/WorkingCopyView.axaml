<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Subverted.App.ViewModels"
             xmlns:p="using:Subverted.App.Presentation"
             xmlns:v="using:Subverted.App.Views"
             x:Class="Subverted.App.Views.WorkingCopyView"
             x:DataType="vm:WorkingCopyViewModel">
  <!-- Ctrl+Enter commits from the table too, not only from the message box. -->
  <UserControl.KeyBindings>
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding Composer.CommitCommand}" />
  </UserControl.KeyBindings>

  <UserControl.Styles>
    <Style Selector="TextBox.filter">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="6,3,8,3" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="TextBlock.root">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <!-- Until a row is picked the diff has nothing to show, and the table takes its rows too. -->
    <Style Selector="DockPanel.alone">
      <Setter Property="Grid.RowSpan" Value="3" />
    </Style>
    <Style Selector="TextBlock.column">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- Above the tree and the table, so what a write said stays on screen when it leaves nothing listed. -->
    <StackPanel DockPanel.Dock="Top">
      <Border IsVisible="{Binding IsStale}" Padding="12,6"
              Background="{DynamicResource Tone.Missing.Soft}">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Path Classes="icon" Data="{StaticResource Icon.Unplugged}" Width="14" Height="14"
                Stroke="{DynamicResource Tone.Missing}" />
          <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource Tone.Missing}" Text="{Binding Headline}" />
          <TextBlock Classes="muted" Text="— showing the last listing that came back." />
        </StackPanel>
      </Border>
      <v:NoticeView Margin="8" Notice="{Binding RevertPrompt.Notice}"
                    IsVisible="{Binding RevertPrompt.Notice, Converter={x:Static ObjectConverters.IsNotNull}}"
                    DismissCommand="{Binding RevertPrompt.DismissNoticeCommand}" />
      <v:NoticeView x:Name="UpdateNotice" Margin="8" Notice="{Binding Updater.Notice}"
                    IsVisible="{Binding Updater.Notice, Converter={x:Static ObjectConverters.IsNotNull}}"
                    DismissCommand="{Binding Updater.DismissNoticeCommand}" />
    </StackPanel>

    <Panel>
      <!-- SmartSVN's arrangement: the directory tree on the left, the file table top right, and the
           selected file's diff under it at the table's full width. -->
      <Grid IsVisible="{Binding HasChanges}">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="232" MinWidth="160" />
          <ColumnDefinition Width="1" />
          <ColumnDefinition Width="*" MinWidth="420" />
        </Grid.ColumnDefinitions>

        <!-- Directory tree: every folder holding a change, with how many. Choosing one narrows the table. -->
        <DockPanel Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
          <ListBox x:Name="Folders" Classes="table" ItemsSource="{Binding Folders}"
                   SelectedItem="{Binding SelectedFolder, Mode=TwoWay}" AutomationProperties.Name="Folders">
            <ListBox.Styles>
              <Style Selector="ListBoxItem" x:DataType="vm:FolderEntry">
                <Setter Property="AutomationProperties.Name" Value="{Binding Content.AutomationName}" />
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="vm:FolderEntry">
                <Grid ColumnDefinitions="Auto,Auto,*,Auto" Height="28" Margin="8,0,12,0">
                  <Border Width="{Binding Content.Depth, Converter={x:Static v:TreeIndent.Width}}" />
                  <Path Grid.Column="1" Classes="icon" Data="{StaticResource Icon.Folder}" Width="14" Height="14"
                        Margin="0,0,8,0" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                             Classes.root="{Binding Content.IsRoot}" Text="{Binding Content.Name}" />
                  <TextBlock Grid.Column="3" Classes="muted" FontSize="11.5" VerticalAlignment="Center"
                             Text="{Binding Content.Count}" />
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>

        <Border Grid.Column="1" Background="{DynamicResource LineBrush}" />
        <GridSplitter Grid.Column="1" Background="Transparent" Width="5" Margin="-2,0" ResizeDirection="Columns" />

        <Grid Grid.Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="*" MinHeight="140" />
            <RowDefinition Height="1" />
            <RowDefinition Height="*" MinHeight="140" />
          </Grid.RowDefinitions>

          <DockPanel Grid.Row="0" Classes.alone="{Binding !Diff.HasSelection}">
            <!-- The filter, and what it hides. Acting on a row is its menu's job. -->
            <Border DockPanel.Dock="Top" Classes="pane-header" Height="40">
              <Grid ColumnDefinitions="260,Auto">
                <TextBox x:Name="FilterBox" Classes="filter" Text="{Binding Filter, Mode=TwoWay}"
                         PlaceholderText="Filter by path" AutomationProperties.Name="Filter changes by path">
                  <TextBox.InnerLeftContent>
                    <Path Classes="icon" Data="{StaticResource Icon.Search}" Width="13" Height="13" Margin="8,0,0,0" />
                  </TextBox.InnerLeftContent>
                </TextBox>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0"
                            IsVisible="{Binding HiddenText, Converter={x:Static ObjectConverters.IsNotNull}}">
                  <TextBlock x:Name="HiddenLine" Classes="faint" FontSize="12" VerticalAlignment="Center"
                             Text="{Binding HiddenText}" />
                  <Button Classes="link" Content="Show all" VerticalAlignment="Center" Command="{Binding ClearFilterCommand}" />
                </StackPanel>
              </Grid>
            </Border>



            <!-- Column heads, on the same widths as the rows below them. -->
            <Border DockPanel.Dock="Top" Classes="line-bottom" Height="26" IsVisible="{Binding !!Entries.Count}">
              <Grid ColumnDefinitions="32,104,2*,3*,72" Margin="8,0,10,0">
                <TextBlock Grid.Column="1" Classes="column" Text="State" />
                <TextBlock Grid.Column="2" Classes="column" Text="Name" />
                <TextBlock Grid.Column="3" Classes="column" Text="Folder" />
              </Grid>
            </Border>

            <Panel>
              <ListBox x:Name="List" Classes="table" ItemsSource="{Binding Entries}" IsVisible="{Binding !!Entries.Count}"
                       SelectedItem="{Binding SelectedEntry, Mode=TwoWay}" AutomationProperties.Name="Changes">
                <ListBox.Styles>
                  <!-- Without it, a screen reader reads out the line's record, braces and all. -->
                  <Style Selector="ListBoxItem" x:DataType="vm:ChangeListEntry">
                    <Setter Property="AutomationProperties.Name" Value="{Binding Content.AutomationName}" />
                  </Style>
                </ListBox.Styles>
                <ListBox.ContextMenu>
                  <ContextMenu>
                    <MenuItem Header="Open" InputGesture="Enter"
                              Command="{Binding OpenCommand}" CommandParameter="{Binding SelectedEntry}" />
                    <MenuItem Header="{DynamicResource Text.Reveal}"
                              Command="{Binding RevealCommand}" CommandParameter="{Binding SelectedEntry}" />
                    <MenuItem Header="Copy path"
                              Command="{Binding CopyPathCommand}" CommandParameter="{Binding SelectedEntry}" />
                    <Separator />
                    <MenuItem Header="Revert…"
                              Command="{Binding RevertCommand}" CommandParameter="{Binding SelectedEntry}" />
                    <Separator />
                    <MenuItem Header="History of this file"
                              Command="{Binding ShowHistoryCommand}" CommandParameter="{Binding SelectedEntry}" />
                  </ContextMenu>
                </ListBox.ContextMenu>
                <ListBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ChangeListEntry">
                    <Grid ColumnDefinitions="32,104,2*,3*,72" Height="28" Margin="8,0,10,0">
                      <CheckBox Classes="tick" Focusable="False" IsVisible="{Binding CanTick}"
                                IsChecked="{Binding TickMark, Mode=OneWay}" IsEnabled="{Binding IsTickable}"
                                Command="{Binding $parent[ListBox].((vm:WorkingCopyViewModel)DataContext).ToggleTickCommand}"
                                CommandParameter="{Binding}" AutomationProperties.Name="Tick" />
                      <Path Classes="icon" Data="{StaticResource Icon.Folder}" Width="14" Height="14"
                            HorizontalAlignment="Left" IsVisible="{Binding !CanTick}" />

                      <ContentControl Grid.Column="1" Content="{Binding Row}" VerticalAlignment="Center">
                        <ContentControl.ContentTemplate>
                          <DataTemplate x:DataType="p:ChangeRow">
                            <StackPanel Orientation="Horizontal" Spacing="7">
                              <Border Width="3" Height="14" CornerRadius="2" VerticalAlignment="Center"
                                      Background="{Binding Badge.Tone, Converter={x:Static v:ToneBrush.Solid}}" />
                              <TextBlock Text="{Binding Badge.Label}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                                         Foreground="{Binding Badge.Tone, Converter={x:Static v:ToneBrush.Solid}}" />
                            </StackPanel>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>

                      <TextBlock Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                        <Run Text="{Binding Content.Name}" FontWeight="Medium" />
                        <Run Text="{Binding Row.RenameCaption}" Foreground="{DynamicResource Tone.Renamed}" />
                      </TextBlock>
                      <TextBlock Grid.Column="3" Classes="muted" FontSize="12" Margin="0,0,10,0" VerticalAlignment="Center"
                                 TextTrimming="CharacterEllipsis" Text="{Binding Content.Folder}" />

                      <ContentControl Grid.Column="4" Content="{Binding Row}" VerticalAlignment="Center" HorizontalAlignment="Right">
                        <ContentControl.ContentTemplate>
                          <DataTemplate x:DataType="p:ChangeRow">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                              <Path Classes="icon" Data="{StaticResource Icon.History}" Width="13" Height="13"
                                    IsVisible="{Binding IsCopied}" ToolTip.Tip="Scheduled with history — a copy or a move" />
                              <Border Classes="tag" IsVisible="{Binding HasPropertyChange}" ToolTip.Tip="Its properties changed too">
                                <TextBlock Classes="muted" Text="props" FontSize="10.5" />
                              </Border>
                              <Path Classes="icon" Data="{StaticResource Icon.Lock}" Width="13" Height="13"
                                    IsVisible="{Binding IsLocked}" ToolTip.Tip="You hold the lock on this file" />
                            </StackPanel>
                          </DataTemplate>
                        </ContentControl.ContentTemplate>
                      </ContentControl>
                    </Grid>
                  </DataTemplate>
                </ListBox.ItemTemplate>
              </ListBox>

            </Panel>
          </DockPanel>

          <Border Grid.Row="1" Background="{DynamicResource LineBrush}" IsVisible="{Binding Diff.HasSelection}" />
          <GridSplitter Grid.Row="1" Background="Transparent" Height="5" Margin="0,-2" ResizeDirection="Rows"
                        IsVisible="{Binding Diff.HasSelection}" />

          <v:DiffPaneView Grid.Row="2" DataContext="{Binding Diff}" IsVisible="{Binding HasSelection}" />
        </Grid>
      </Grid>

      <!-- Clean is an answer, and says so rather than showing an empty table. -->
      <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding IsClean}">
        <Path Classes="icon" Data="{StaticResource Icon.Check}" Width="28" Height="28"
              Stroke="{DynamicResource Tone.Added}" StrokeThickness="2" HorizontalAlignment="Center" />
        <TextBlock Classes="empty-title" Text="No local changes" />
        <TextBlock Classes="muted" HorizontalAlignment="Center"
                   Text="Everything here matches the revision you last updated to." />
      </StackPanel>

      <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                  IsVisible="{Binding State, Converter={x:Static v:StateIs.Loading}}">
        <ProgressBar Classes="spinner" />
        <TextBlock Classes="muted" HorizontalAlignment="Center" Text="Reading the working copy…" />
      </StackPanel>

      <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="440"
                  IsVisible="{Binding IsBlocked}">
        <Path Classes="icon" Data="{StaticResource Icon.Alert}" Width="28" Height="28"
              Stroke="{DynamicResource Tone.Missing}" HorizontalAlignment="Center" />
        <TextBlock Classes="empty-title" Text="{Binding Headline}" />
        <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center"
                   TextWrapping="Wrap" Text="{Binding Message}" />
      </StackPanel>

      <!-- Last, so it covers everything while the question stands. -->
      <v:RevertPromptView DataContext="{Binding RevertPrompt}" />
    </Panel>
  </DockPanel>
</UserControl>
