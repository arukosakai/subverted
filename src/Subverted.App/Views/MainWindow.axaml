<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Subverted.App.ViewModels"
        xmlns:p="using:Subverted.App.Presentation"
        xmlns:v="using:Subverted.App.Views"
        x:Class="Subverted.App.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="Subverted"
        Width="1280" Height="820" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        WindowDecorationsTheme="{StaticResource SubvertedWindowDecorations}"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        TransparencyBackgroundFallback="{DynamicResource BgBrush}"
        Background="Transparent">

  <Grid ColumnDefinitions="64,*">

    <!-- The rail, as oto's: the only translucent surface, so the window material shows at its edge. -->
    <Border Grid.Column="0" Classes="line-right">
      <Border.Background>
        <SolidColorBrush Color="{DynamicResource RailColor}" Opacity="0.7" />
      </Border.Background>
      <Grid RowDefinitions="44,*,Auto">
        <!-- The title line runs on through the rail's corner, and the mark lets drags through to it. -->
        <Border Grid.Row="0" Classes="line-bottom" Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar">
          <Border x:Name="AppMark" Width="28" Height="28" CornerRadius="{StaticResource CardRadius}"
                  Background="{DynamicResource SurfaceBrush}" IsHitTestVisible="False">
            <Path Classes="icon" Data="{StaticResource Icon.Branch}" Width="16" Height="16"
                  StrokeThickness="2" Stroke="{DynamicResource TextBrush}" />
          </Border>
        </Border>

        <StackPanel Grid.Row="1" Spacing="6" HorizontalAlignment="Center" Margin="0,6,0,0">
          <Button x:Name="ChangesView" Classes="nav" Classes.active="{Binding IsShowingChanges}"
                  ToolTip.Tip="Changes" AutomationProperties.Name="Changes"
                  IsEnabled="{Binding HasWorkingCopy}" Command="{Binding ShowChangesCommand}">
            <Path Classes="icon" Data="{StaticResource Icon.Changes}" />
          </Button>
          <Button x:Name="HistoryView" Classes="nav" Classes.active="{Binding IsShowingHistory}"
                  ToolTip.Tip="History" AutomationProperties.Name="History"
                  IsEnabled="{Binding HasWorkingCopy}" Command="{Binding ShowHistoryCommand}">
            <Path Classes="icon" Data="{StaticResource Icon.History}" />
          </Button>
        </StackPanel>

        <StackPanel Grid.Row="2" Spacing="6" HorizontalAlignment="Center" Margin="0,0,0,14">
          <Button Classes="nav" ToolTip.Tip="Open working copy…" AutomationProperties.Name="Open working copy"
                  Command="{Binding OpenFolderCommand}">
            <Path Classes="icon" Data="{StaticResource Icon.FolderPlus}" />
          </Button>
          <Button x:Name="ThemeButton" Classes="nav" ToolTip.Tip="Theme" AutomationProperties.Name="Theme">
            <Path Classes="icon" Data="{StaticResource Icon.Palette}" />
            <Button.Flyout>
              <Flyout Placement="RightEdgeAlignedBottom">
                <v:ThemeMenu x:Name="ThemeMenu" />
              </Flyout>
            </Button.Flyout>
          </Button>
        </StackPanel>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="44,*,Auto,Auto,Auto" Background="{DynamicResource BgBrush}">

      <!-- Title bar: which working copy, where it points, and whether the answer is live. The drag
           area sits behind the controls, and the right margin leaves the caption buttons their strip. -->
      <Border Grid.Row="0" Classes="line-bottom" Background="Transparent"
              WindowDecorationProperties.ElementRole="TitleBar" />
      <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" Margin="8,0,150,1">
          <Button Grid.Column="0" x:Name="Switcher" Classes="flat" VerticalAlignment="Center"
                  AutomationProperties.Name="Switch working copy">
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Path Classes="icon" Data="{StaticResource Icon.Folder}" Width="15" Height="15" />
              <TextBlock Classes="title" VerticalAlignment="Center"
                         Text="{Binding Current.Name, FallbackValue='Subverted', TargetNullValue='Subverted'}" />
              <Path Classes="icon" Data="{StaticResource Icon.ChevronDown}" Width="12" Height="12" />
            </StackPanel>
            <Button.Flyout>
              <Flyout Placement="BottomEdgeAlignedLeft">
                <StackPanel MinWidth="280" Spacing="2">
                  <TextBlock Classes="section" Text="WORKING COPIES" Margin="8,4,8,6"
                             IsVisible="{Binding !!Recent.Count}" />
                  <ItemsControl ItemsSource="{Binding Recent}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:RecentWorkingCopy">
                        <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).SelectCommand}"
                                CommandParameter="{Binding}" ToolTip.Tip="{Binding Path}">
                          <Grid ColumnDefinitions="Auto,*">
                            <Path Classes="icon" Data="{StaticResource Icon.Folder}" Width="14" Height="14" Margin="0,0,10,0" />
                            <StackPanel Grid.Column="1">
                              <TextBlock Text="{Binding Name}" FontWeight="Medium"
                                         Classes.title="{Binding IsCurrent}" FontSize="13" />
                              <TextBlock Classes="faint" FontSize="11" Text="{Binding Path}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="line-top" Margin="0,4,0,0" Padding="0,4,0,0">
                    <Button Classes="flat" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                            Command="{Binding OpenFolderCommand}">
                      <StackPanel Orientation="Horizontal" Spacing="10">
                        <Path Classes="icon" Data="{StaticResource Icon.FolderPlus}" Width="14" Height="14" />
                        <TextBlock Text="Open working copy…" />
                      </StackPanel>
                    </Button>
                  </Border>
                </StackPanel>
              </Flyout>
            </Button.Flyout>
          </Button>

          <TextBlock Grid.Column="1" Classes="faint" FontSize="12" VerticalAlignment="Center" Margin="6,0,0,0"
                     TextTrimming="CharacterEllipsis" IsHitTestVisible="False"
                     Text="{Binding Current.RepositoryRoot, FallbackValue=''}" />

          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center"
                      IsHitTestVisible="False" ToolTip.Tip="Kept current by the daemon while this window is in front"
                      IsVisible="{Binding Current.State, Converter={x:Static v:StateIs.Ready}, FallbackValue=False}">
            <Ellipse Classes="live" VerticalAlignment="Center" />
            <TextBlock Classes="muted" FontSize="12" Text="Live" />
          </StackPanel>
      </Grid>

      <Panel Grid.Row="1" IsVisible="{Binding HasWorkingCopy}">
        <Panel IsVisible="{Binding IsShowingChanges}">
          <v:WorkingCopyView DataContext="{Binding Current}" />
        </Panel>
        <Panel IsVisible="{Binding IsShowingHistory}">
          <v:HistoryView DataContext="{Binding History}" />
        </Panel>
      </Panel>

      <!-- The bottom strip, SmartSVN's: write a message on the left, read what every write said on the right. -->
      <Border Grid.Row="2" Height="1" Background="{DynamicResource LineBrush}" IsVisible="{Binding #Strip.IsVisible}" />
      <Grid Grid.Row="3" x:Name="Strip" Height="200" ColumnDefinitions="*,1,*">
        <Grid.IsVisible>
          <MultiBinding Converter="{x:Static BoolConverters.And}">
            <Binding Path="HasWorkingCopy" />
            <Binding Path="IsShowingChanges" />
          </MultiBinding>
        </Grid.IsVisible>
        <v:CommitComposerView Grid.Column="0" x:Name="Composer" DataContext="{Binding Current.Composer, FallbackValue={x:Null}}" />
        <Border Grid.Column="1" Background="{DynamicResource LineBrush}" />
        <v:OutputLogView Grid.Column="2" x:Name="OutputLog" DataContext="{Binding Log}" />
      </Grid>

      <!-- First run: the one thing to do, said once, in the middle. -->
      <StackPanel Grid.Row="1" Grid.RowSpan="3" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                  MaxWidth="420" IsVisible="{Binding !HasWorkingCopy}">
        <Path Classes="icon" Data="{StaticResource Icon.Folder}" Width="36" Height="36" StrokeThickness="1.5"
              HorizontalAlignment="Center" />
        <TextBlock Classes="empty-title" Text="Open a working copy" />
        <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                   Text="Pick any folder inside an SVN checkout. Subverted keeps its status live while this window is in front." />
        <Button Classes="accent" HorizontalAlignment="Center" Margin="0,8,0,0" Command="{Binding OpenFolderCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{StaticResource Icon.FolderPlus}" Width="14" Height="14" />
            <TextBlock Text="Choose folder…" />
          </StackPanel>
        </Button>
      </StackPanel>

      <!-- Status line, SmartSVN's: where this is and what it holds, in one row. -->
      <Border Grid.Row="4" Classes="line-top" Height="24" Padding="12,0"
              IsVisible="{Binding HasWorkingCopy}">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Classes="faint" FontSize="11.5" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                     Text="{Binding Current.Location, FallbackValue=''}" />
          <ItemsControl Grid.Column="1" VerticalAlignment="Center" ItemsSource="{Binding Current.Summary, FallbackValue={x:Null}}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <StackPanel Orientation="Horizontal" Spacing="14" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="p:ChangeCount">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                           Fill="{Binding Tone, Converter={x:Static v:ToneBrush.Solid}}" />
                  <TextBlock Classes="muted" FontSize="11.5" Text="{Binding Text}" />
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
