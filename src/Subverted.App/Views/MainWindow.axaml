<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Subverted.App.ViewModels"
        xmlns:v="using:Subverted.App.Views"
        x:Class="Subverted.App.Views.MainWindow"
        x:Name="Root"
        x:DataType="vm:MainWindowViewModel"
        Title="Subverted"
        Width="1180" Height="760" MinWidth="820" MinHeight="520"
        WindowStartupLocation="CenterScreen"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="48"
        WindowDecorationsTheme="{StaticResource SubvertedWindowDecorations}"
        TransparencyLevelHint="Mica, AcrylicBlur, None"
        TransparencyBackgroundFallback="{DynamicResource WindowFallbackBrush}"
        Background="Transparent">

  <Grid ColumnDefinitions="264,*">

    <!-- Sidebar. The top 48px sit under the title bar: a drag area on Windows, and where the
         traffic lights live on macOS, which is why its inset is set per platform in code. -->
    <Border Grid.Column="0" Classes="sidebar">
      <Grid RowDefinitions="48,Auto,Auto,*,Auto">
        <Border Grid.Row="0" Background="Transparent"
                WindowDecorationProperties.ElementRole="TitleBar" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="10" Margin="20,4,20,22">
          <Border Width="28" Height="28" CornerRadius="9">
            <Border.Background>
              <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
                <GradientStop Offset="0" Color="{DynamicResource SystemAccentColorLight1}" />
                <GradientStop Offset="1" Color="{DynamicResource SystemAccentColorDark1}" />
              </LinearGradientBrush>
            </Border.Background>
            <Path Data="{StaticResource Icon.Branch}" Stroke="White" StrokeThickness="2"
                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform" Width="15" Height="15" />
          </Border>
          <TextBlock Classes="brand" Text="Subverted" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Grid.Row="2" Classes="section" Text="WORKING COPIES" Margin="22,0,20,8"
                   IsVisible="{Binding !!Recent.Count}" />

        <ItemsControl Grid.Row="3" Margin="10,0" ItemsSource="{Binding Recent}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:RecentWorkingCopy">
              <Button Classes="sidebar-item" Classes.current="{Binding IsCurrent}"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                      Command="{Binding #Root.((vm:MainWindowViewModel)DataContext).SelectCommand}"
                      CommandParameter="{Binding}" ToolTip.Tip="{Binding Path}">
                <StackPanel Orientation="Horizontal" Spacing="10">
                  <Path Classes="icon" Data="{StaticResource Icon.Folder}" />
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button Grid.Row="4" Classes="accent" Margin="16" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" Command="{Binding OpenFolderCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{StaticResource Icon.Plus}" Width="14" Height="14" />
            <TextBlock Text="Open working copy" />
          </StackPanel>
        </Button>
      </Grid>
    </Border>

    <Grid Grid.Column="1" RowDefinitions="48,*">
      <Border Grid.Row="0" Background="Transparent" WindowDecorationProperties.ElementRole="TitleBar" />

      <Panel Grid.Row="1" IsVisible="{Binding HasWorkingCopy}">
        <v:WorkingCopyView DataContext="{Binding Current}" />
      </Panel>

      <!-- First run: the one thing to do, said once, in the middle. -->
      <StackPanel Grid.Row="1" Spacing="12" HorizontalAlignment="Center" VerticalAlignment="Center"
                  MaxWidth="420" IsVisible="{Binding !HasWorkingCopy}">
        <Border Width="64" Height="64" CornerRadius="20" HorizontalAlignment="Center" Classes="panel">
          <Path Classes="icon" Data="{StaticResource Icon.Folder}" Width="28" Height="28" />
        </Border>
        <TextBlock Classes="empty-title" FontSize="22" Text="Open a working copy" />
        <TextBlock Classes="muted" TextAlignment="Center" TextWrapping="Wrap"
                   Text="Pick any folder inside an SVN checkout. Subverted keeps its status live while this window is in front." />
        <Button Classes="accent" HorizontalAlignment="Center" Margin="0,8,0,0" Command="{Binding OpenFolderCommand}">
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Path Classes="icon" Data="{StaticResource Icon.Plus}" Width="14" Height="14" />
            <TextBlock Text="Choose folder…" />
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
