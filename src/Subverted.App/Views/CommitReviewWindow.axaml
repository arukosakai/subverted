<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Subverted.App.ViewModels"
        xmlns:p="using:Subverted.App.Presentation"
        xmlns:v="using:Subverted.App.Views"
        x:Class="Subverted.App.Views.CommitReviewWindow"
        x:DataType="vm:CommitReviewViewModel"
        Title="Review commit"
        Width="1100" Height="720" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaTitleBarHeightHint="44"
        WindowDecorationsTheme="{StaticResource SubvertedWindowDecorations}"
        Background="{DynamicResource BgBrush}">
  <Window.KeyBindings>
    <KeyBinding Gesture="Escape" Command="{Binding CancelCommand}" />
    <KeyBinding Gesture="Ctrl+Enter" Command="{Binding Composer.CommitCommand}" />
  </Window.KeyBindings>

  <Window.Styles>
    <Style Selector="TextBlock.column">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="44,*,1,Auto">
    <!-- The same title line as the main window's; the right margin leaves the caption buttons their strip. -->
    <Border Grid.Row="0" Classes="line-bottom" Background="Transparent"
            WindowDecorationProperties.ElementRole="TitleBar" />
    <TextBlock Grid.Row="0" Classes="title" Margin="16,0,150,1" VerticalAlignment="Center"
               IsHitTestVisible="False" Text="Review commit" />

    <Grid Grid.Row="1">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="400" MinWidth="260" />
        <ColumnDefinition Width="1" />
        <ColumnDefinition Width="*" MinWidth="320" />
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0" Background="{DynamicResource SurfaceBrush}">
        <Border DockPanel.Dock="Top" Classes="line-bottom" Height="26">
          <Grid ColumnDefinitions="32,104,2*,3*" Margin="8,0,10,0">
            <TextBlock Grid.Column="1" Classes="column" Text="State" />
            <TextBlock Grid.Column="2" Classes="column" Text="Name" />
            <TextBlock Grid.Column="3" Classes="column" Text="Folder" />
          </Grid>
        </Border>

        <ListBox x:Name="List" Classes="table" ItemsSource="{Binding Changes}"
                 SelectedItem="{Binding SelectedChange, Mode=TwoWay}" AutomationProperties.Name="Changes to commit">
          <ListBox.Styles>
            <Style Selector="ListBoxItem" x:DataType="vm:ChangeListEntry">
              <Setter Property="AutomationProperties.Name" Value="{Binding Content.AutomationName}" />
            </Style>
          </ListBox.Styles>
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:ChangeListEntry">
              <Grid ColumnDefinitions="32,104,2*,3*" Height="28" Margin="8,0,10,0">
                <CheckBox Classes="tick" Focusable="False"
                          IsChecked="{Binding TickMark, Mode=OneWay}" IsEnabled="{Binding IsTickable}"
                          Command="{Binding $parent[ListBox].((vm:CommitReviewViewModel)DataContext).ToggleTickCommand}"
                          CommandParameter="{Binding}" AutomationProperties.Name="Tick" />

                <ContentControl Grid.Column="1" Content="{Binding Row}" VerticalAlignment="Center">
                  <ContentControl.ContentTemplate>
                    <DataTemplate x:DataType="p:ChangeRow">
                      <StackPanel Orientation="Horizontal" Spacing="7">
                        <Border Width="3" Height="14" CornerRadius="2" VerticalAlignment="Center"
                                Background="{Binding Badge.Tone, Converter={x:Static v:ToneBrush.Solid}}" />
                        <TextBlock Text="{Binding Badge.Label}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"
                                   Foreground="{Binding Badge.Tone, Converter={x:Static v:ToneBrush.Solid}}" />
                      </StackPanel>
                    </DataTemplate>
                  </ContentControl.ContentTemplate>
                </ContentControl>

                <TextBlock Grid.Column="2" Margin="0,0,10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                  <Run Text="{Binding Content.Name}" FontWeight="Medium" />
                  <Run Text="{Binding Row.RenameCaption}" Foreground="{DynamicResource Tone.Renamed}" />
                </TextBlock>
                <TextBlock Grid.Column="3" Classes="muted" FontSize="12" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Text="{Binding Content.Folder}" />
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <Border Grid.Column="1" Background="{DynamicResource LineBrush}" />
      <GridSplitter Grid.Column="1" Background="Transparent" Width="5" Margin="-2,0" ResizeDirection="Columns" />

      <v:DiffPaneView Grid.Column="2" DataContext="{Binding Diff}" />
    </Grid>

    <Border Grid.Row="2" Background="{DynamicResource LineBrush}" />

    <!-- The strip's own message, notice and command, so what is written or said here is the strip's too. -->
    <DockPanel Grid.Row="3" DataContext="{Binding Composer}" x:DataType="vm:CommitComposerViewModel">
      <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"
                  Margin="12,0,12,10">
        <ProgressBar Classes="spinner" Width="60" VerticalAlignment="Center" IsVisible="{Binding IsCommitting}" />
        <Button x:Name="CancelButton" Classes="flat" Content="Cancel" ToolTip.Tip="Esc"
                Command="{Binding $parent[Window].((vm:CommitReviewViewModel)DataContext).CancelCommand}" />
        <Button x:Name="CommitButton" Classes="accent" Content="{Binding ButtonText}" ToolTip.Tip="Ctrl+Enter"
                Command="{Binding CommitCommand}" AutomationProperties.Name="{Binding ButtonText}" />
      </StackPanel>

      <v:NoticeView DockPanel.Dock="Bottom" x:Name="CommitNotice" Margin="12,0,12,8"
                    Notice="{Binding Notice}" DismissCommand="{Binding DismissNoticeCommand}" />

      <TextBox x:Name="MessageBox" Height="96" Margin="12,10,12,8" Text="{Binding Message, Mode=TwoWay}"
               PlaceholderText="Commit message…" AcceptsReturn="True" TextWrapping="Wrap"
               VerticalContentAlignment="Top" IsEnabled="{Binding !IsCommitting}"
               AutomationProperties.Name="Commit message" />
    </DockPanel>
  </Grid>
</Window>
