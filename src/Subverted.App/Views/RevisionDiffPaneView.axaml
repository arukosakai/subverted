<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Subverted.App.ViewModels"
             xmlns:v="using:Subverted.App.Views"
             x:Class="Subverted.App.Views.RevisionDiffPaneView"
             x:DataType="vm:RevisionDiffPaneViewModel">
  <Border Classes="panel" Padding="8">
    <DockPanel>
      <!-- The path and revision being shown, with the badge its row carries in the paths list. -->
      <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="10,8,10,10"
            IsVisible="{Binding Path, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Border Classes="badge" VerticalAlignment="Center"
                Background="{Binding Path.Badge.Tone, Converter={x:Static v:ToneBrush.Soft}}">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <Ellipse Width="6" Height="6" VerticalAlignment="Center"
                     Fill="{Binding Path.Badge.Tone, Converter={x:Static v:ToneBrush.Solid}}" />
            <TextBlock Text="{Binding Path.Badge.Label}" FontSize="11.5" FontWeight="SemiBold"
                       Foreground="{Binding Path.Badge.Tone, Converter={x:Static v:ToneBrush.Solid}}" />
          </StackPanel>
        </Border>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="14,0,0,0"
                    VerticalAlignment="Center">
          <TextBlock Text="{Binding Path.Name}" FontWeight="SemiBold" />
          <TextBlock Classes="faint" Text="{Binding Path.Folder}" TextTrimming="CharacterEllipsis" />
        </StackPanel>
        <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center" FontFamily="{StaticResource MonoFont}"
                   Text="{Binding Revision, StringFormat='r{0}'}" />
      </Grid>

      <Panel>
        <v:DiffLinesView IsVisible="{Binding State, Converter={x:Static v:DiffPaneStateIs.Ready}}"
                         Document="{Binding Document}" />

        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding State, Converter={x:Static v:DiffPaneStateIs.NothingSelected}}">
          <Path Classes="icon" Data="{StaticResource Icon.Diff}" Width="28" Height="28"
                Stroke="{DynamicResource FaintBrush}" HorizontalAlignment="Center" />
          <TextBlock Classes="faint" HorizontalAlignment="Center" Text="Select a changed path to see what the revision did" />
        </StackPanel>

        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center"
                    IsVisible="{Binding State, Converter={x:Static v:DiffPaneStateIs.Loading}}">
          <ProgressBar IsIndeterminate="True" Width="140" />
          <TextBlock Classes="muted" HorizontalAlignment="Center" Text="Asking the server for the diff…" />
        </StackPanel>

        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                    IsVisible="{Binding State, Converter={x:Static v:DiffPaneStateIs.NothingToShow}}">
          <Border Width="52" Height="52" CornerRadius="26" HorizontalAlignment="Center"
                  Background="{DynamicResource Tone.Quiet.Soft}">
            <Path Classes="icon" Data="{StaticResource Icon.Diff}" Width="22" Height="22" />
          </Border>
          <TextBlock Classes="empty-title" Text="Nothing to compare" />
          <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center"
                     TextWrapping="Wrap" Text="{Binding Message}" />
        </StackPanel>

        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                    IsVisible="{Binding State, Converter={x:Static v:DiffPaneStateIs.Unreachable}}">
          <Border Width="52" Height="52" CornerRadius="26" HorizontalAlignment="Center"
                  Background="{DynamicResource Tone.Missing.Soft}">
            <Path Classes="icon" Data="{StaticResource Icon.Unplugged}" Width="24" Height="24"
                  Stroke="{DynamicResource Tone.Missing}" StrokeThickness="2" />
          </Border>
          <TextBlock Classes="empty-title" Text="The daemon is not answering" />
          <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center"
                     TextWrapping="Wrap" Text="{Binding Message}" />
        </StackPanel>

        <StackPanel Spacing="10" HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="400"
                    IsVisible="{Binding State, Converter={x:Static v:DiffPaneStateIs.Failed}}">
          <Border Width="52" Height="52" CornerRadius="26" HorizontalAlignment="Center"
                  Background="{DynamicResource Tone.Missing.Soft}">
            <Path Classes="icon" Data="{StaticResource Icon.Alert}" Width="24" Height="24"
                  Stroke="{DynamicResource Tone.Missing}" StrokeThickness="2" />
          </Border>
          <TextBlock Classes="empty-title" Text="The diff could not be read" />
          <TextBlock Classes="muted" HorizontalAlignment="Center" TextAlignment="Center"
                     TextWrapping="Wrap" Text="{Binding Message}" />
        </StackPanel>
      </Panel>
    </DockPanel>
  </Border>
</UserControl>
