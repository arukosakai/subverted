<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Testing.Extensions.CodeCoverage" />
    <PackageReference Include="TUnit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Subverted.Daemon\Subverted.Daemon.csproj" />
    <!-- Only to start the built daemon the way the front-ends do, in LaunchedDaemonTests. -->
    <ProjectReference Include="..\..\src\Subverted.Frontend\Subverted.Frontend.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same throwaway-repository fixture the SVN tests drive. Linked rather than copied so
         there is one definition of what a test working copy is. -->
    <Compile Include="..\Subverted.Svn.Tests\SvnWorkingCopy.cs" Link="SvnWorkingCopy.cs" />
    <Compile Include="..\Subverted.Svn.Tests\WorkingCopyWedge.cs" Link="WorkingCopyWedge.cs" />
    <Compile
      Include="..\Subverted.Svn.Tests\SvnConsoleForTheRun.cs"
      Link="SvnConsoleForTheRun.cs"
    />
  </ItemGroup>
</Project>
